# CP Compiler — Environment Variables
# Copy to .env and customize before deployment.

# REQUIRED: Bearer token for API authentication.
# Must be at least 32 characters with high entropy.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_TOKEN=change-me-to-a-secure-random-token

# Service
SERVICE_NAME=cp-compiler
LOG_LEVEL=INFO

# Resource limits (ICPC/IOI standards)
DEFAULT_TIME_LIMIT_MS=1000
DEFAULT_MEMORY_LIMIT_MB=256
MAX_TIME_LIMIT_MS=30000
MAX_MEMORY_LIMIT_MB=1024
OUTPUT_LIMIT_MB=16

# Compilation cache
COMPILE_CACHE_MAX_ENTRIES=256
COMPILE_CACHE_TTL_SECONDS=600

# Backpressure (0 = auto-tune based on CPU count)
MAX_INFLIGHT_JUDGE_REQUESTS=0

# Uvicorn workers (0 = auto, recommended: 2 × CPU cores)
UVICORN_WORKERS=4

# CORS origins (comma-separated, leave empty to disable)
CORS_ORIGINS=

# Trusted hosts (comma-separated)
TRUSTED_HOSTS=localhost,127.0.0.1
